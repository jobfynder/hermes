[Unit]
Description=Move old nvoids Gmail messages to Trash
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hermes
ExecStart=/usr/bin/flock -E 0 -n /run/hermes-gmail-cleanup.lock /usr/bin/docker compose exec -T hermes-api python scripts/hermes-850-gmail-cleanup.py
TimeoutStartSec=30min
