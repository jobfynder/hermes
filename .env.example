HERMES_SERVICE_NAME=Hermes
HERMES_VERSION=0.2.3
HERMES_ENV=development

HERMES_RBAC_ENFORCEMENT=disabled
HERMES_ACCESS_CONTROL_FILE=/hermes-runtime/access-control/users.json

# HERMES-200 Understanding fallback controls
# Keep disabled by default. Enable only after privacy/quota/review rules are finalized.
HERMES_CLOUD_EXTRACTION_FALLBACK_ENABLED=false
HERMES_LLM_FALLBACK_ENABLED=false

# Optional Unstructured.io cloud extraction fallback
# Keep disabled by default.
HERMES_UNSTRUCTURED_ENABLED=false
HERMES_UNSTRUCTURED_API_KEY=
HERMES_UNSTRUCTURED_API_URL=

# HERMES-450 Telegram Provider Bridge
HERMES_PUBLIC_WEBHOOK_BASE_URL=https://your-hermes-domain.example.com
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_WEBHOOK_SECRET=

# HERMES-450 LinkedIn OAuth Foundation
HERMES_LINKEDIN_CLIENT_ID=
HERMES_LINKEDIN_CLIENT_SECRET=
HERMES_LINKEDIN_REDIRECT_URI=https://hermes.jobfynder.com/providers/linkedin/callback

# HERMES-450 BrightData Public Profile Parser
HERMES_BRIGHTDATA_API_KEY=
HERMES_BRIGHTDATA_PROFILE_API_URL=

# COMM-1 → Hermes authenticated handoff
HERMES_COMM_SHARED_SECRET=
HERMES_COMM_SIGNATURE_MAX_AGE_SECONDS=300
