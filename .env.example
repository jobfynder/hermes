HERMES_SERVICE_NAME=Hermes
HERMES_VERSION=0.2.3
HERMES_ENV=development

HERMES_RBAC_ENFORCEMENT=disabled
HERMES_ACCESS_CONTROL_FILE=/hermes-runtime/access-control/users.json

# HERMES-200 Understanding fallback controls
# Keep disabled by default. Enable only after privacy/quota/review rules are finalized.
HERMES_CLOUD_EXTRACTION_FALLBACK_ENABLED=false
HERMES_LLM_FALLBACK_ENABLED=false
