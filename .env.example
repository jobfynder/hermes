HERMES_SERVICE_NAME=Hermes
HERMES_VERSION=0.2.3
HERMES_ENV=development

HERMES_RBAC_ENFORCEMENT=disabled
HERMES_ACCESS_CONTROL_FILE=/hermes-runtime/access-control/users.json

# HERMES-200 Understanding fallback controls
# Keep disabled by default. Enable only after privacy/quota/review rules are finalized.
HERMES_CLOUD_EXTRACTION_FALLBACK_ENABLED=false
HERMES_LLM_FALLBACK_ENABLED=false

# Optional Unstructured.io cloud extraction fallback
# Keep disabled by default.
HERMES_UNSTRUCTURED_ENABLED=false
HERMES_UNSTRUCTURED_API_KEY=
HERMES_UNSTRUCTURED_API_URL=

# HERMES-450 Telegram Provider Bridge
HERMES_PUBLIC_WEBHOOK_BASE_URL=https://your-hermes-domain.example.com
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_WEBHOOK_SECRET=

# HERMES-450 LinkedIn OAuth Foundation
HERMES_LINKEDIN_CLIENT_ID=
HERMES_LINKEDIN_CLIENT_SECRET=
HERMES_LINKEDIN_REDIRECT_URI=https://hermes.jobfynder.com/providers/linkedin/callback

# HERMES-450 BrightData Public Profile Parser
HERMES_BRIGHTDATA_API_KEY=
HERMES_BRIGHTDATA_PROFILE_API_URL=

# HERMES-850 Gmail Provider (OAuth, contract only - not yet configured)
HERMES_GMAIL_CLIENT_ID=
HERMES_GMAIL_CLIENT_SECRET=
HERMES_GMAIL_REFRESH_TOKEN=
HERMES_GMAIL_PUBSUB_TOPIC=

# HERMES-850 Microsoft Graph Provider (Office 365, contract only - not yet configured)
HERMES_MS_GRAPH_CLIENT_ID=
HERMES_MS_GRAPH_CLIENT_SECRET=
HERMES_MS_GRAPH_TENANT_ID=
# Comma-separated subscription targets. Each entry is either a bare
# mailbox address (watches its Inbox -- the default) or
# "address:FolderDisplayName" to watch a specific folder instead/in
# addition -- notifications only fire for the exact folder subscribed,
# so a mailbox-side rule that silently files mail into a subfolder (a
# vendor's job-board postings landing in a "Nvoids" folder, say) makes
# that mail invisible to Hermes no matter how healthy the Inbox
# subscription is, until that folder gets its own entry here too. Same
# address can appear more than once with different folders. See
# configured_mailbox_targets() in app/providers/microsoft_graph/
# service.py.
#
# Jobfynder runs two dedicated mailboxes -- jobs@jobfynder.com for
# requirement email, hotlists@jobfynder.com for hotlist email (split
# from the original single shared inbox; see HERMES_HOTLIST_MAILBOX/
# HERMES_REQUIREMENTS_MAILBOX below, which must point at these same two
# addresses for classify_recipient_mailbox() to resolve them). If mail
# to either address doesn't carry a clean recipient match (e.g. it's
# addressed to both at once), detect_document_kind()
# (app/channels/service.py) still falls through to
# classify_email_by_confidence() as a fallback -- runs both the hotlist
# and requirement parsers and keeps whichever scored higher on its own
# confidence metric. See that function's docstring in
# app/email_parsing/parsers.py.
HERMES_MS_GRAPH_MAILBOXES=jobs@jobfynder.com,jobs@jobfynder.com:Nvoids,hotlists@jobfynder.com
# Random secret Hermes both sends when creating the subscription and
# checks on every inbound notification (Graph's anti-spoofing mechanism --
# see verify_notification_client_state() in
# app/providers/microsoft_graph/service.py). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
HERMES_MS_GRAPH_CLIENT_STATE=
# Required by hermes-graph-consumer on INTEL-1. Use COMM-1's Tailscale IP,
# never the Docker-only hostname `rabbitmq` or COMM-1's public IP.
RABBITMQ_URL=
# Subscription creation/renewal uses HERMES_PUBLIC_WEBHOOK_BASE_URL above
# (must be a real, publicly-reachable HTTPS URL -- Graph will not create a
# subscription pointing at localhost or a self-signed cert).

# HERMES-850 mailbox routing. Must match the two real addresses in
# HERMES_MS_GRAPH_MAILBOXES above exactly -- classify_recipient_mailbox()
# (app/email_parsing/routing.py) uses these two values, not
# HERMES_MS_GRAPH_MAILBOXES, to decide whether an inbound email's
# recipient means "hotlist" or "job requirement". If either of these
# doesn't match the real mailbox address, mail to that mailbox silently
# falls through to classify_email_by_confidence() (content-only
# classification) on every message instead of resolving instantly and
# reliably from the recipient address -- it was HERMES_REQUIREMENTS_
# MAILBOX drifting out of sync like this (left at the old single-shared-
# inbox placeholder after Jobfynder split into two real mailboxes) that
# caused HERMES-850's "jobs@ mail isn't parsing" incident.
HERMES_HOTLIST_MAILBOX=hotlists@jobfynder.com
HERMES_REQUIREMENTS_MAILBOX=jobs@jobfynder.com

# COMM-1 → Hermes authenticated handoff
HERMES_COMM_SHARED_SECRET=
HERMES_COMM_SIGNATURE_MAX_AGE_SECONDS=300

# HERMES-750 Prompt Runtime / LiteLLM Foundation
# Keep dry-run enabled until provider routing, privacy, quota, and approval rules are finalized.
HERMES_PROMPT_RUNTIME_DRY_RUN=true
HERMES_PROMPT_RUN_LOG_DIR=/hermes-runtime/prompt-runs
HERMES_PROMPT_DEFAULT_MODEL=anthropic/claude-haiku-4-5
LITELLM_API_KEY=
LITELLM_BASE_URL=https://gateway.jobfynder.com/v1/chat/completions
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://langfuse.jobfynder.com

# Prompt registry cache and fetch tuning
HERMES_LANGFUSE_PROMPT_CACHE_SECONDS=300
HERMES_LANGFUSE_PROMPT_FETCH_CONCURRENCY=8

# Hermes landing database (drafts, claims, field provenance, dedupe index,
# intake history -- see app/runtime/db.py). Dedicated to Hermes, separate
# from Jobfynder Core's database. In docker-compose.yml this points at the
# hermes-postgres service on the compose network; HERMES_POSTGRES_PASSWORD
# below must match what that service was started with.
DATABASE_URL=postgresql://hermes:CHANGEME@hermes-postgres:5432/hermes
HERMES_POSTGRES_PASSWORD=CHANGEME

# Push-to-Core (app/integrations/core_job_push.py): only PUBLISHED job-
# requirement drafts ever reach this. Core's own POST /hermes/job/create
# is guarded by this same shared secret (src/hermes/hermes-auth.guard.ts
# in jobFynder-BE-nestJS) -- the two values must match exactly, or every
# push fails with 401. Ask whoever owns that repo's .env for the current
# value rather than generating a new one.
CORE_API_BASE_URL=https://uat.jobfynder.com/api
HERMES_SERVICE_TOKEN=CHANGEME
